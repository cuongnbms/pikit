{
  "_comment": "Place this file at ~/.pi/agent/configs/styled-outputs.json",
  "assistantMessage": {
    "prefix": "●",
    "color": "text"
  },
  "userMessage": {
    "prefix": ">",
    "color": "dim",
    "bodyColor": "text",
    "isThemeBackgroundVisible": true
  },
  "thinkingMessage": {
    "prefix": "✻",
    "prefixColor": "muted",
    "label": "Thinking…",
    "labelColor": "muted",
    "isLabelVisible": true,
    "messageColor": "dim"
  },
  "skills": {
    "prefix": "●",
    "prefixColor": "success",
    "titleColor": "toolTitle",
    "nameColor": "text",
    "labelColor": "text",
    "expandHintColor": "dim",
    "outputColor": "dim"
  },
  "customMessages": {
    "prefix": "●",
    "prefixColor": "success",
    "titleColor": "toolTitle",
    "nameColor": "text",
    "labelColor": "text",
    "expandHintColor": "dim",
    "outputColor": "dim"
  },
  "bashExecution": {
    "titleColor": "bashMode"
  },
  "tools": {
    "toolSpinnerPrefix": {
      "prefixChars": ["·", "✢", "✳", "✶", "✻", "✽"],
      "color": "muted"
    },
    "toolSuccess": {
      "prefix": "●",
      "prefixColor": "success",
      "labelColor": "text"
    },
    "toolError": {
      "prefix": "●",
      "prefixColor": "error",
      "labelColor": "error"
    },
    "toolBranch": {
      "prefix": "  ⎿ ",
      "color": "dim"
    },
    "general": {
      "titleColor": "toolTitle",
      "summaryColor": "text",
      "countColor": "muted",
      "expandHintColor": "dim",
      "outputColor": "dim",
      "maxExpandedLines": 40,
      "collapsedPreviewLines": 3,
      "moreColor": "muted",
      "moreBgColor": "separator",
      "isThemeBackgroundVisible": false,
      "verticalPadding": 0,
      "horizontalPadding": 1,
      "diffAddedColor": "toolDiffAdded",
      "diffRemovedColor": "toolDiffRemoved",
      "diffContextColor": "toolDiffContext",
      "maxDiffFileSize": "1MB"
    },
    "groups": {
      "base": {},
      "custom": {}
    }
  }
}
